APP_NAME="Paystack API Explorer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Retention (days) for storage/logs/paystack-*.log
PAYSTACK_LOG_DAYS=30

# --- Database -----------------------------------------------------------
# SQLite works out of the box (database/database.sqlite).
DB_CONNECTION=sqlite
# For MySQL (e.g. XAMPP):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=paystack_console
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sessions & security ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving over HTTPS (always in production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Comma-separated proxy IPs (or *) when behind a load balancer / tunnel.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Password reset emails. "log" writes them to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="explorer@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- First administrator (used by `php artisan db:seed`) ------------------
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Paystack -------------------------------------------------------------
# Keys are read server-side only. They are never sent to the browser,
# stored in the database, logged, or shown in the request inspector / cURL.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT=30
PAYSTACK_CONNECT_TIMEOUT=10
PAYSTACK_DEFAULT_COUNTRY=NG

# Generic test keys: used for any country without its own keys below.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Generic live keys (only used if live mode is enabled).
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=

# Per-market keys (a Paystack integration belongs to one country).
PAYSTACK_NG_TEST_SECRET_KEY=
PAYSTACK_NG_TEST_PUBLIC_KEY=
PAYSTACK_NG_LIVE_SECRET_KEY=
PAYSTACK_NG_LIVE_PUBLIC_KEY=

PAYSTACK_GH_TEST_SECRET_KEY=
PAYSTACK_GH_TEST_PUBLIC_KEY=
PAYSTACK_GH_LIVE_SECRET_KEY=
PAYSTACK_GH_LIVE_PUBLIC_KEY=

PAYSTACK_KE_TEST_SECRET_KEY=
PAYSTACK_KE_TEST_PUBLIC_KEY=
PAYSTACK_KE_LIVE_SECRET_KEY=
PAYSTACK_KE_LIVE_PUBLIC_KEY=

PAYSTACK_ZA_TEST_SECRET_KEY=
PAYSTACK_ZA_TEST_PUBLIC_KEY=
PAYSTACK_ZA_LIVE_SECRET_KEY=
PAYSTACK_ZA_LIVE_PUBLIC_KEY=

PAYSTACK_CI_TEST_SECRET_KEY=
PAYSTACK_CI_TEST_PUBLIC_KEY=
PAYSTACK_CI_LIVE_SECRET_KEY=
PAYSTACK_CI_LIVE_PUBLIC_KEY=

# Live mode stays OFF unless this is true AND an admin enables the
# "live_mode_enabled" flag AND the user has live permission AND confirms
# every request.
PAYSTACK_LIVE_ENABLED=false

# Demo mode: validate requests but return labelled mock responses
# instead of calling Paystack.
PAYSTACK_MOCK_MODE=false

# Rate limits (requests per minute)
PAYSTACK_EXECUTE_PER_MINUTE=30
PAYSTACK_EXECUTE_PER_IP_PER_MINUTE=60
PAYSTACK_WEBHOOKS_PER_MINUTE=120
LOGIN_MAX_ATTEMPTS=5

# Webhooks
PAYSTACK_WEBHOOKS_ENABLED=true
# Reject webhook requests not coming from Paystack's documented IPs.
PAYSTACK_WEBHOOK_ENFORCE_IPS=false

# Request history
PAYSTACK_HISTORY_STORE_RESPONSES=true
PAYSTACK_HISTORY_MAX_RESPONSE_KB=256
PAYSTACK_HISTORY_RETENTION_DAYS=30
PAYSTACK_UPLOAD_MAX_KB=5120
